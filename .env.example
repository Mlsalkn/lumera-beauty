APP_NAME="Luméra Beauty"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost/lumera-beauty/public
APP_TIMEZONE=Europe/Istanbul
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lumera_beauty_db
DB_USERNAME=
DB_PASSWORD=
APPOINTMENT_CANCEL_BEFORE_MINUTES=120
APPOINTMENT_RESCHEDULE_BEFORE_MINUTES=120
APPOINTMENT_BOOKING_DAYS=90
APPOINTMENT_SLOT_MINUTES=15
MAIL_DRIVER=disabled
MAIL_FROM_ADDRESS=

# disabled: no SMTP required; smtp: production relay; smtp_test: loopback + example.invalid only
MAIL_FROM_NAME="Luméra Beauty"
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
# Base64 of 32 cryptographically random bytes. Never commit the real key.
MAIL_ENCRYPTION_KEY=
# Existing accounts remain usable. Enable only after testing real delivery.
EMAIL_REQUIRE_VERIFICATION=false